# SRAG Mossoró - Environment Variables
# Copy this file to .env and fill in the values

# Database Connection (Optional - defaults to SQLite project path)
# DATABASE_URL=sqlite:///data/processed/srag_mossoro.db

# Logfire - Observability (Optional)
# LOGFIRE_TOKEN=your_token_here

# Auth JWT (obrigatório em produção; gere com: openssl rand -hex 32)
# JWT_SECRET=troque-este-segredo
# Access/refresh lifetimes (Optional)
# AUTH_ACCESS_TOKEN_MINUTES=60
# AUTH_REFRESH_TOKEN_DAYS=7
# Bootstrap: o primeiro POST /auth/register cria o ADMIN inicial sem token.
